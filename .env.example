# Copy to `.env` in this folder and set your key (`.env` is gitignored).
# Load before push: `set -a && source .env && set +a`  (bash/zsh)
WIDGETBOOK_API_KEY=

# Optional overrides for Widgetbook Cloud (otherwise inferred from git / CI):
# WIDGETBOOK_REPOSITORY=my-org/my_design_system
# WIDGETBOOK_BRANCH=main
# WIDGETBOOK_COMMIT=full_sha
# WIDGETBOOK_ACTOR=Your Name
